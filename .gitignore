# Datasets, caches, and trained models: large, regenerable, and per the mentor's
# instruction never committed -- the README says how to download them instead.
# The empty folder skeleton is kept so a fresh clone has somewhere to put them.
**/data/**
!**/data/**/
!**/data/**/.gitkeep

# Editor / IDE
.idea/
.ipynb_checkpoints/

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Per-project virtualenvs
.venv/
